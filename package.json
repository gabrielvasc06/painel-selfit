{
  "name": "painel-selfit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "start": "node scripts/start-production.mjs",
    "dev": "npm --prefix Frontend run dev",
    "api:start": "npm --prefix Backend start",
    "api:start:homologacao": "node scripts/run-with-api-env.mjs Backend/.env.homolog npm --prefix Backend start",
    "api:migrate": "npm --prefix Backend run migrate",
    "api:migrate:homologacao": "node scripts/run-with-api-env.mjs Backend/.env.homolog npm --prefix Backend run migrate",
    "db:seed": "node Backend/scripts/seed-local-database.mjs",
    "db:seed:homologacao": "node scripts/run-with-api-env.mjs Backend/.env.homolog node Backend/scripts/seed-local-database.mjs",
    "db:seed:check": "node Backend/scripts/seed-local-database.mjs --dry-run",
    "db:seed:check:homologacao": "node scripts/run-with-api-env.mjs Backend/.env.homolog node Backend/scripts/seed-local-database.mjs --dry-run",
    "build": "npm --prefix Frontend run build",
    "build:homologacao": "npm --prefix Frontend run build:homologacao",
    "lint": "npm --prefix Frontend run lint",
    "homologacao": "node scripts/run-with-api-env.mjs Backend/.env.homolog node Backend/scripts/homologacao-software.mjs",
    "preview": "npm --prefix Frontend run preview",
    "preview:homologacao": "npm --prefix Frontend run preview:homologacao",
    "typecheck": "npm --prefix Frontend run typecheck",
    "test": "npm --prefix Frontend test && npm --prefix Backend test",
    "user:create": "npm --prefix Backend run user:create",
    "package:deploy": "npm run build && node scripts/package-deploy.mjs",
    "check": "npm run lint && npm test && npm run build",
    "test:integration": "node scripts/test-deploy-integration.mjs",
    "api:migrate:status": "npm --prefix Backend run migrate:status",
    "api:migrate:production": "node scripts/run-with-api-env.mjs Backend/.env npm --prefix Backend run migrate -- --env production",
    "user:create:production": "node scripts/run-with-api-env.mjs Backend/.env npm --prefix Backend run user:create",
    "db:audit": "node Backend/scripts/database/audit.mjs",
    "db:audit:homologacao": "node scripts/run-with-api-env.mjs Backend/.env.homolog node Backend/scripts/database/audit.mjs",
    "db:backup": "node Backend/scripts/database/backup.mjs",
    "db:backup:homologacao": "node scripts/run-with-api-env.mjs Backend/.env.homolog node Backend/scripts/database/backup.mjs",
    "db:schema:export": "node Backend/scripts/database/export-schema.mjs principal.sql && node scripts/run-with-api-env.mjs Backend/.env.homolog node Backend/scripts/database/export-schema.mjs homologacao.sql",
    "test:migrations": "node Backend/scripts/test-existing-migrations.mjs",
    "test:migrations:homologacao": "node scripts/run-with-api-env.mjs Backend/.env.homolog node Backend/scripts/test-existing-migrations.mjs",
    "db:audit:production": "node scripts/run-with-api-env.mjs Backend/.env node Backend/scripts/database/audit.mjs",
    "db:backup:production": "node scripts/run-with-api-env.mjs Backend/.env node Backend/scripts/database/backup.mjs",
    "dev:homologacao": "npm --prefix Frontend run dev:homologacao"
  }
}
