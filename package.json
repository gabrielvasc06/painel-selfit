{
  "name": "painel-selfit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/start-production.mjs",
    "dev": "vite --host 0.0.0.0 --port 5174 --strictPort",
    "api:start": "npm --prefix api-selfit start",
    "api:start:homologacao": "node scripts/run-with-api-env.mjs api-selfit/.env.homolog npm --prefix api-selfit start",
    "api:migrate": "npm --prefix api-selfit run migrate",
    "api:migrate:homologacao": "node scripts/run-with-api-env.mjs api-selfit/.env.homolog npm --prefix api-selfit run migrate",
    "db:seed": "node scripts/seed-local-database.mjs",
    "db:seed:homologacao": "node scripts/run-with-api-env.mjs api-selfit/.env.homolog node scripts/seed-local-database.mjs",
    "db:seed:check": "node scripts/seed-local-database.mjs --dry-run",
    "db:seed:check:homologacao": "node scripts/run-with-api-env.mjs api-selfit/.env.homolog node scripts/seed-local-database.mjs --dry-run",
    "build": "npm run typecheck && vite build",
    "build:homologacao": "npm run typecheck && vite build --mode homolog",
    "lint": "eslint .",
    "homologacao": "node scripts/run-with-api-env.mjs api-selfit/.env.homolog node scripts/homologacao-software.mjs",
    "preview": "vite preview",
    "preview:homologacao": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs && npm --prefix api-selfit test",
    "user:create": "npm --prefix api-selfit run user:create",
    "package:deploy": "npm run build && node scripts/package-deploy.mjs",
    "check": "npm run lint && npm test && npm run build",
    "test:integration": "node scripts/test-deploy-integration.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "read-excel-file": "^9.3.10",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  }
}
