# Copie para api-selfit/.env.production e use SELFIT_ENV_FILE no deploy sem Docker.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
FRONT=https://painel.sua-empresa.com.br
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=selfit_db
DB_USER=selfit_app
DB_PASSWORD=
JWT_SECRET=
DB_POOL_SIZE=10
DB_SSL=false
# DB_SSL_CA_FILE=/caminho/mysql-ca.pem
ACCESS_ALLOWED_CIDRS=127.0.0.1/32,::1/128
ACCESS_ALLOWED_USERS=ADMIN
USER_ADMIN_USERS=ADMIN
TRUST_PROXY=
