# Arquivo: api-selfit/.env.homolog.example
# Serve para: modelo de ambiente de homologacao local, usando banco separado do desenvolvimento/principal.

PORT=3001
FRONT=http://localhost:4173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=selfit_homolog

JWT_SECRET=troque_esta_chave_no_ambiente_de_homologacao

ACCESS_ALLOWED_USERS=ADMIN
USER_ADMIN_USERS=ADMIN
HOMOLOG_USER=ADMIN
HOMOLOG_PASSWORD=
HOST=127.0.0.1
ACCESS_ALLOWED_CIDRS=127.0.0.1/32,::1/128
