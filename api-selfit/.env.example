# Arquivo: api-selfit/.env.example
# Serve para: modelo de variaveis locais da API. Copie para api-selfit/.env e ajuste a senha do MySQL.

PORT=3000
FRONT=http://localhost:5174

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=selfit_db

JWT_SECRET=troque_esta_chave_no_ambiente_local

ACCESS_ALLOWED_USERS=ADMIN
USER_ADMIN_USERS=ADMIN
HOST=127.0.0.1
ACCESS_ALLOWED_CIDRS=127.0.0.1/32,::1/128
