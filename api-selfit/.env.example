# Modelo unico. Copie para .env, .env.homolog ou .env.production dentro de api-selfit/.
# Nao sobrescreva ambientes reais que ja estejam configurados.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
FRONT=http://localhost:5174
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=selfit_db
DB_USER=selfit_app
DB_PASSWORD=
JWT_SECRET=
DB_POOL_SIZE=10
DB_SSL=false
# DB_SSL_CA_FILE=/caminho/mysql-ca.pem
ACCESS_ALLOWED_CIDRS=127.0.0.1/32,::1/128
ACCESS_ALLOWED_USERS=ADMIN
USER_ADMIN_USERS=ADMIN
TRUST_PROXY=
# Apenas para MySQL incluido no Docker; use DB_HOST=db nesse caso.
MYSQL_ROOT_PASSWORD=
# Apenas para a bateria de homologacao.
HOMOLOG_USER=ADMIN
HOMOLOG_PASSWORD=
