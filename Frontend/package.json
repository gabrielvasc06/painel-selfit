{
  "name": "selfit-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native --host 0.0.0.0 --port 5174 --strictPort",
    "dev:homologacao": "vite --configLoader native --mode homolog --host 0.0.0.0 --port 4173 --strictPort",
    "build": "npm run typecheck && vite --configLoader native build",
    "build:homologacao": "npm run typecheck && vite --configLoader native build --mode homolog",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite --configLoader native preview --host 0.0.0.0 --port 5174 --strictPort",
    "preview:homologacao": "vite --configLoader native preview --mode homolog --host 0.0.0.0 --port 4173 --strictPort"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "read-excel-file": "^9.3.10",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  }
}
