# Copie para .env.production. Usado pelo Compose; nunca envie o arquivo real ao Git.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
BIND_ADDRESS=127.0.0.1
APP_PORT=8080
FRONT=https://painel.sua-empresa.com.br
# Em compose.mysql.yaml use db. Para banco existente use seu host privado.
DB_HOST=db
DB_PORT=3306
DB_DATABASE=selfit_db
DB_USER=selfit_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
DB_POOL_SIZE=10
# Para MySQL gerenciado, ative TLS e monte a CA se o provedor exigir.
DB_SSL=false
# DB_SSL_CA_FILE=/run/certs/mysql-ca.pem
# O exemplo so permite acesso local. Adicione as redes reais da TI/VPN antes de liberar o painel.
ACCESS_ALLOWED_CIDRS=127.0.0.1/32,::1/128
# Lista explicita de logins existentes no banco (separados por virgula).
ACCESS_ALLOWED_USERS=ADMIN
USER_ADMIN_USERS=ADMIN
# Informe somente IPs/CIDRs dos proxies administrados pelo TI, nunca true ou 0.0.0.0/0.
TRUST_PROXY=
