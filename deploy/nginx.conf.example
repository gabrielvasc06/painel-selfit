# Ajuste dominio e certificados. Nao exponha a porta Node diretamente na internet.
server {
    listen 80;
    server_name painel.sua-empresa.com.br;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name painel.sua-empresa.com.br;
    ssl_certificate /etc/ssl/selfit/fullchain.pem;
    ssl_certificate_key /etc/ssl/selfit/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 2m;
    location / {
        # Use 3000 para Node nativo ou 8080 para a publicacao padrao do Compose.
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Substitui cabecalhos enviados pelo cliente, evitando aceitar IP forjado.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 30s;
    }
}
