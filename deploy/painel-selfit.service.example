[Unit]
Description=Painel Selfit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=selfit
Group=selfit
WorkingDirectory=/opt/painel-selfit
Environment=NODE_ENV=production
EnvironmentFile=/opt/painel-selfit/api-selfit/.env.production
ExecStart=/usr/bin/node /opt/painel-selfit/api-selfit/src/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
